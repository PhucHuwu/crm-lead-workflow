# ==========================================
# CẤU HÌNH BẢO MẬT & TÍCH HỢP HỆ THỐNG
# Sao chép file này thành .env và điền thông tin thực tế
# ==========================================

# 1. TINACRM REST API — secret chỉ cấu hình cục bộ
# API key được tạo với Role và Expiration Date trong Settings > MCP & APIs > API.
# Token chứa phạm vi workspace; không dùng workspace ID thay cho token.
TINACRM_BASE_URL=""
# Khóa không lưu ở đây: scripts/tinacrm_save_key lưu vào config/tinacrm_api_key.txt,
# scripts/tinacrm_rest.py đọc từ đó và tự thêm Authorization: Bearer <token>.
# Chỉ dùng khi đã thiết lập workflow trigger riêng trong CRM.
# Source hiện có /webhooks/workflows/:workspaceId/:workflowId public, không kiểm tra Bearer tại controller.
TINACRM_LEAD_WORKFLOW_URL=""
TINACRM_TASK_WORKFLOW_URL=""
# Secret webhook thông báo là để xác minh chữ ký CRM -> nơi nhận, không phải API key.
TINACRM_OUTBOUND_WEBHOOK_SECRET=""

# 2. CÀO LEAD & TÀI KHOẢN (Bước 8)
# Khuyến nghị dùng session cookie thay vì mật khẩu trực tiếp
LINKEDIN_SESSION_COOKIE="li_at=AQED..."
FACEBOOK_SESSION_COOKIE="c_user=...; xs=..."

# 3. GỬI EMAIL CHĂM SÓC & BÁO CÁO TUẦN (Bước 11 & Bước 13)
# Tùy chọn A: Dùng SMTP
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="marketing@yourcompany.com"
SMTP_PASSWORD="app_specific_password_here"

# Tùy chọn B: Dùng API Service (Resend / SendGrid)
RESEND_API_KEY="re_123456789..."

# 4. EMAIL NHẬN BÁO CÁO TUẦN CỦA QUẢN LÝ (Bước 13)
WEEKLY_REPORT_RECIPIENT_EMAIL="ceo@yourcompany.com"
REPORT_SCHEDULE_DAY="Monday"
REPORT_SCHEDULE_TIME="08:00"
